{
  "components": {
    "schemas": {
      "ActionRequest": {
        "properties": {
          "action": {
            "title": "Action",
            "type": "integer"
          }
        },
        "required": [
          "action"
        ],
        "title": "ActionRequest",
        "type": "object"
      },
      "CreateGameRequest": {
        "properties": {
          "game": {
            "default": "king_is_dead",
            "title": "Game",
            "type": "string"
          },
          "params": {
            "$ref": "#/components/schemas/GameParams"
          },
          "seats": {
            "items": {
              "enum": [
                "human",
                "random"
              ],
              "type": "string"
            },
            "title": "Seats",
            "type": "array"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "required": [
          "seats"
        ],
        "title": "CreateGameRequest",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GameExport": {
        "description": "Replay file: everything needed to rebuild a game by replaying `history`.",
        "properties": {
          "game": {
            "title": "Game",
            "type": "string"
          },
          "history": {
            "items": {
              "type": "integer"
            },
            "title": "History",
            "type": "array"
          },
          "params": {
            "$ref": "#/components/schemas/GameParams"
          },
          "seats": {
            "items": {
              "enum": [
                "human",
                "random"
              ],
              "type": "string"
            },
            "title": "Seats",
            "type": "array"
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "game",
          "params",
          "seats",
          "seed",
          "history"
        ],
        "title": "GameExport",
        "type": "object"
      },
      "GameParams": {
        "description": "Creation parameters for a game.",
        "properties": {
          "num_players": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of players (2 or 3).",
            "title": "Num Players"
          }
        },
        "title": "GameParams",
        "type": "object"
      },
      "GameView": {
        "description": "A game as seen by one seat.",
        "properties": {
          "bot_thinking": {
            "description": "A bot seat is to move (not yet played).",
            "title": "Bot Thinking",
            "type": "boolean"
          },
          "game": {
            "title": "Game",
            "type": "string"
          },
          "history_length": {
            "title": "History Length",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "seat": {
            "title": "Seat",
            "type": "integer"
          },
          "seat_types": {
            "items": {
              "enum": [
                "human",
                "random"
              ],
              "type": "string"
            },
            "title": "Seat Types",
            "type": "array"
          },
          "seats": {
            "items": {
              "enum": [
                "human",
                "random"
              ],
              "type": "string"
            },
            "title": "Seats",
            "type": "array"
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          },
          "view": {
            "additionalProperties": true,
            "description": "Adapter-defined view payload.",
            "title": "View",
            "type": "object"
          }
        },
        "required": [
          "id",
          "game",
          "seats",
          "seat_types",
          "seed",
          "bot_thinking",
          "seat",
          "history_length",
          "view"
        ],
        "title": "GameView",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReportRequest": {
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "e.g. \"engine\", \"ui\", \"other\".",
            "title": "Category"
          },
          "note": {
            "description": "What went wrong (required).",
            "minLength": 1,
            "title": "Note",
            "type": "string"
          }
        },
        "required": [
          "note"
        ],
        "title": "ReportRequest",
        "type": "object"
      },
      "ReportResponse": {
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "report_id": {
            "title": "Report Id",
            "type": "string"
          }
        },
        "required": [
          "report_id",
          "path"
        ],
        "title": "ReportResponse",
        "type": "object"
      },
      "RewindRequest": {
        "properties": {
          "player_actions": {
            "title": "Player Actions",
            "type": "integer"
          }
        },
        "required": [
          "player_actions"
        ],
        "title": "RewindRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "King is Dead server",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/games": {
      "post": {
        "operationId": "create_game",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Game"
      }
    },
    "/api/games/import": {
      "post": {
        "operationId": "import_game",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GameExport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Import Game"
      }
    },
    "/api/games/{game_id}": {
      "get": {
        "operationId": "get_game",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "seat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Seat"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Game"
      }
    },
    "/api/games/{game_id}/actions": {
      "post": {
        "operationId": "post_action",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Action"
      }
    },
    "/api/games/{game_id}/back": {
      "post": {
        "operationId": "go_back",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Go Back"
      }
    },
    "/api/games/{game_id}/export": {
      "get": {
        "operationId": "export_game",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameExport"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Export Game"
      }
    },
    "/api/games/{game_id}/report": {
      "post": {
        "operationId": "report_game",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Report Game"
      }
    },
    "/api/games/{game_id}/rewind": {
      "post": {
        "operationId": "rewind_game",
        "parameters": [
          {
            "in": "path",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RewindRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameView"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Rewind Game"
      }
    }
  }
}
